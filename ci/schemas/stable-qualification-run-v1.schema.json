{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StableQualificationRunV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "candidate_tag", "candidate_commit", "run_id",
    "run_attempt", "created_at_utc", "event", "status", "gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "StableQualificationRunV1" },
    "candidate_tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "run_id": { "type": "integer", "minimum": 1 },
    "run_attempt": { "const": 1 },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "event": { "const": "schedule" },
    "status": { "const": "passed" },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "const": "passed" }
    }
  }
}
