{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StableQualificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "candidate_tag", "candidate_commit",
    "required_scheduled_runs", "qualified", "status", "utc_dates", "runs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "StableQualificationV1" },
    "candidate_tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
    "candidate_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "required_scheduled_runs": { "type": "integer", "minimum": 1 },
    "qualified": { "const": true },
    "status": { "const": "qualified" },
    "utc_dates": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } },
    "runs": { "type": "array", "minItems": 1, "items": { "$ref": "stable-qualification-run-v1.schema.json" } }
  }
}
